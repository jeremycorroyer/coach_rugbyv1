<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Rugby Coach PWA</title>
    
    <!-- Paramètres clés pour que Safari / iOS traite la page comme une application native -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="RugbyCoach">
    
    <!-- Style Tailwind CSS via CDN pour un design propre et rapide -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white min-h-screen flex flex-col">

    <!-- En-tête -->
    <header class="bg-slate-800 p-4 border-b border-slate-700 flex justify-between items-center">
        <h1 class="text-xl font-bold tracking-wide text-amber-500">🏉 Rugby Coach App</h1>
        <span id="match-timer" class="text-sm bg-slate-700 px-3 py-1 rounded-full font-mono">00:00</span>
    </header>

    <!-- Contenu Principal -->
    <main class="flex-1 p-4 max-w-md mx-w-lg w-full mx-auto space-y-6">
        
        <!-- Tableau d'affichage / Score -->
        <div class="bg-slate-800 p-5 rounded-2xl shadow-lg border border-slate-700 text-center">
            <h2 class="text-xs uppercase tracking-wider text-slate-400 mb-2">Score du Match</h2>
            <div class="text-6xl font-black text-amber-400 mb-4" id="score">0 - 0</div>
            
            <div class="grid grid-cols-2 gap-4">
                <button onclick="addScore(5)" class="bg-emerald-600 hover:bg-emerald-500 active:scale-95 transition p-3 rounded-xl font-bold text-sm shadow">
                    +5 Essai
                </button>
                <button onclick="addScore(2)" class="bg-blue-600 hover:bg-blue-500 active:scale-95 transition p-3 rounded-xl font-bold text-sm shadow">
                    +2 Transformation
                </button>
                <button onclick="addScore(3)" class="bg-indigo-600 hover:bg-indigo-500 active:scale-95 transition p-3 rounded-xl font-bold text-sm shadow">
                    +3 Pénalité / Drop
                </button>
                <button onclick="resetScore()" class="bg-rose-700 hover:bg-rose-600 active:scale-95 transition p-3 rounded-xl font-bold text-sm shadow">
                    Remise à zéro
                </button>
            </div>
        </div>

        <!-- Section Statistiques / Événements rapides -->
        <div class="bg-slate-800 p-5 rounded-2xl shadow-lg border border-slate-700">
            <h3 class="text-sm uppercase tracking-wider text-slate-400 mb-3">Compteur d'actions</h3>
            <div class="grid grid-cols-3 gap-3 text-center">
                <div class="bg-slate-700/50 p-3 rounded-xl border border-slate-600">
                    <span class="block text-2xl font-bold text-white" id="stat-plaquages">0</span>
                    <span class="text-xs text-slate-400">Plaquages</span>
                    <button onclick="incrementStat('plaquages')" class="mt-2 w-full bg-slate-600 hover:bg-slate-500 py-1 rounded text-xs">+</button>
                </div>
                <div class="bg-slate-700/50 p-3 rounded-xl border border-slate-600">
                    <span class="block text-2xl font-bold text-white" id="stat-ballons">0</span>
                    <span class="text-xs text-slate-400">Ballons Grattés</span>
                    <button onclick="incrementStat('ballons')" class="mt-2 w-full bg-slate-600 hover:bg-slate-500 py-1 rounded text-xs">+</button>
                </div>
                <div class="bg-slate-700/50 p-3 rounded-xl border border-slate-600">
                    <span class="block text-2xl font-bold text-white" id="stat-fautes">0</span>
                    <span class="text-xs text-slate-400">Fautes / En-avant</span>
                    <button onclick="incrementStat('fautes')" class="mt-2 w-full bg-slate-600 hover:bg-slate-500 py-1 rounded text-xs">+</button>
                </div>
            </div>
        </div>

    </main>

    <!-- Instructions d'installation iOS -->
    <footer class="bg-slate-800 p-4 border-t border-slate-700 text-center text-xs text-slate-400">
        Astuce Safari : Appuyez sur l'icône de partage 
        <span class="inline-block font-bold text-white">⎋</span> 
        puis <strong class="text-white">"Sur l'écran d'accueil"</strong> pour l'utiliser en plein écran.
    </footer>

    <!-- Script de logique simple -->
    <script>
        let currentScore = 0;
        let stats = { plaquages: 0, ballons: 0, fautes: 0 };

        function addScore(points) {
            currentScore += points;
            document.getElementById('score').innerText = currentScore + " - 0";
            if (navigator.vibrate) navigator.vibrate(50); // Petit retour haptique si supporté
        }

        function resetScore() {
            currentScore = 0;
            document.getElementById('score').innerText = "0 - 0";
            stats = { plaquages: 0, ballons: 0, fautes: 0 };
            document.getElementById('stat-plaquages').innerText = 0;
            document.getElementById('stat-ballons').innerText = 0;
            document.getElementById('stat-fautes').innerText = 0;
        }

        function incrementStat(type) {
            stats[type]++;
            document.getElementById(`stat-${type}`).innerText = stats[type];
            if (navigator.vibrate) navigator.vibrate(30);
        }

        // Chronomètre simple de match
        let seconds = 0;
        setInterval(() => {
            seconds++;
            let mins = Math.floor(seconds / 60).toString().padStart(2, '0');
            let secs = (seconds % 60).toString().padStart(2, '0');
            document.getElementById('match-timer').innerText = `${mins}:${secs}`;
        }, 1000);
    </script>
</body>
</html>
